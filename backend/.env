NODE_ENV=development
PORT=3000

# OAuth2 confidential client
CLIENT_ID=WkhEOThmcHZuT1dZNHdnY1VIOVY6MTpjaQ
CLIENT_SECRET=j_XwtN4973ioFyovKDU_FQjqVVuG-9Z3UVjDyhv63qNlkPEOpo

# Must match the X portal callback exactly
REDIRECT_URI=http://localhost:3000/callback

# Keep spaces (NOT %20). Include dm.read dm.write for webhook DMs
SCOPES=tweet.read tweet.write users.read dm.read dm.write offline.access

# Webhook (X Account Activity API). Public URL: https://your-domain.com/webhooks/twitter
WEBHOOK_PATH=/webhooks/twitter
# CRC validation: API Key Secret in X portal; leave empty to reuse CLIENT_SECRET
CONSUMER_SECRET=

# persistence
TOKEN_FILE=./tokens.json
PKCE_FILE=./pkce.json

# optional: 32+ chars for encryption at rest
TOKEN_ENCRYPTION_KEY=change_me_to_a_long_random_secret_32_chars_min

# CORS (frontend later)
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120